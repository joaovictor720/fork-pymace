@@ -338,6 +344,15 @@ static u32 batadv_wifi_flags_evaluate(struct net_device *net_device)
 
 out:
 	dev_put(real_netdev);
+
+emulated_wifi:
+	/* Preserve real WiFi detection when available. The opt-in emulation is
+	 * only a fallback for netdevs such as CORE's VETH interfaces and must
+	 * never claim to provide cfg80211 station information.
+	 */
+	if (!wifi_flags && batadv_emulated_wifi)
+		wifi_flags |= BATADV_HARDIF_WIFI_EMULATED;
