+/**
+ * batadv_is_emulated_wifi_hardif() - check for explicit WiFi emulation
+ * @hard_iface: the device to check
+ *
+ * Return: true if generic WiFi policies were explicitly requested for a
+ * non-wireless netdev, false otherwise.
+ */
+bool batadv_is_emulated_wifi_hardif(struct batadv_hard_iface *hard_iface)
+{
+	if (!hard_iface)
+		return false;
+
+	return !!(hard_iface->wifi_flags & BATADV_HARDIF_WIFI_EMULATED);
+}
