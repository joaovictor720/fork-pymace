+emulated_wifi:
+	/* Preserve real WiFi detection; VETHs must not claim cfg80211 stats. */
+	if (!wifi_flags && batadv_emulated_wifi)
+		wifi_flags |= BATADV_HARDIF_WIFI_EMULATED;
