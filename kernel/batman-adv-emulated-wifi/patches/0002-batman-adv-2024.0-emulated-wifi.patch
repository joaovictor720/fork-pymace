+/**
+ * batadv_is_emulated_wifi_hardif() - check explicit WiFi emulation
+ * @hard_iface: the device to check
+ *
+ * Return: true for a non-wireless hardif with emulated WiFi policies.
+ */
+bool batadv_is_emulated_wifi_hardif(struct batadv_hard_iface *hard_iface)
+{
+	if (!hard_iface)
+		return false;
+
+	return !!(hard_iface->wifi_flags & BATADV_HARDIF_WIFI_EMULATED);
+}
