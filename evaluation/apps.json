			"udp_port": 5001,
			"payload_type_mode": "first_byte_hex",
			"frame_classification": {
				"mode": "protocol_type_byte",
				"payload_types": [2],
				"control_types": [1],
				"type_names": {
					"1": "SUMMARY",
					"2": "UPDATE"
				}
			}
		},
		"usfd": {
			"binary": "apps/crdt/usfd/crdt_usfd",
			"net_setup": "ip",
